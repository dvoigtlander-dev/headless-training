      "command": "python",
      "args": ["plusplus_mcp_server.py"],
      "cwd": "C:\\Users\\dvoigtlander\\claude\\Headless_Training",
      "env": {
        "PLUSPLUS_API_KEY": "${PLUSPLUS_API_KEY}",
        "PLUSPLUS_BASE_URL": "https://sfdc-bt.plusplus.app"
